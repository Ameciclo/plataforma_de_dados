// app/vias-inseguras/useclient.tsx
"use client";
import React, { useState, useEffect } from "react";
import { NumberCards } from "../components/NumberCards";
import { Table } from "../components/Table/Table";
import { vehicleCards } from "./configurationjs";
import { ColumnFilter } from "../components/Table/TableFilters";
import { YearSelector } from "../components/YearSelector";
import { Map } from "../components/Maps/Map";
import { DocumentsList } from "../components/DocumentList";

type Street = {
  streetId: number;
  name: string;
  totalSinistros: number;
  totalFatais: number;
  year?: string;
  geometry?: any;
};

export default function ViasInsegurasContent({ 
  streets, 
  supportFiles = [] 
}: { 
  streets: Street[]; 
  supportFiles: any[] 
}) {
  // Estado para controle do ano selecionado
  const [selectedYear, setSelectedYear] = useState<number | null>(null);
  const [selectedEndYear, setSelectedEndYear] = useState<number | null>(null);
  
  // Extrair anos disponíveis dos dados
  const availableYears = React.useMemo(() => {
    const years = new Set<number>();
    streets.forEach(street => {
      if (street.year) {
        years.add(parseInt(street.year));
      }
    });
    return Array.from(years).sort();
  }, [streets]);

  // Definir o ano mais recente como padrão ao carregar
  useEffect(() => {
    if (availableYears.length > 0 && !selectedYear) {
      const latestYear = Math.max(...availableYears);
      setSelectedYear(latestYear);
    }
  }, [availableYears, selectedYear]);

  // Função para lidar com a mudança de ano
  const handleYearChange = (year, endYear = null) => {
    setSelectedYear(year);
    setSelectedEndYear(endYear);
  };

  // Filtrar dados com base no ano selecionado
  const filteredStreets = React.useMemo(() => {
    if (!selectedYear) return streets;
    
    return streets.filter(street => {
      if (!street.year) return false;
      const streetYear = parseInt(street.year);
      if (!selectedEndYear) {
        return streetYear === selectedYear;
      }
      return streetYear >= selectedYear && streetYear <= selectedEndYear;
    });
  }, [streets, selectedYear, selectedEndYear]);

  // Preparar dados para o mapa
  const mapData = React.useMemo(() => {
    // Verificar se há ruas com geometria válida
    const streetsWithGeometry = filteredStreets.filter(street => street.geometry);
    
    // Se não houver dados de geometria, retornar uma geometria padrão para Recife
    if (streetsWithGeometry.length === 0) {
      return {
        type: "FeatureCollection",
        features: [{
          type: "Feature",
          properties: {},
          geometry: {
            type: "Point",
            coordinates: [-34.881, -8.063] // Coordenadas de Recife
          }
        }]
      };
    }
    
    // Converter os dados das vias para formato GeoJSON
    return {
      type: "FeatureCollection",
      features: streetsWithGeometry.map(street => ({
        type: "Feature",
        properties: {
          id: street.streetId,
          name: street.name,
          sinistros: street.totalSinistros,
          fatais: street.totalFatais,
        },
        geometry: street.geometry
      }))
    };
  }, [filteredStreets]);

  // Configuração das camadas do mapa
  const mapLayers = [
    {
      id: "vias-inseguras",
      type: "line",
      paint: {
        "line-color": [
          "interpolate",
          ["linear"],
          ["get", "sinistros"],
          0, "#FFF176",
          10, "#FFA726",
          20, "#F57F17",
          50, "#E53935",
          100, "#B71C1C"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["get", "sinistros"],
          0, 2,
          100, 8
        ],
        "line-opacity": 0.8
      }
    }
  ];

  // Texto do período selecionado
  const getPeriodoText = () => {
    if (!selectedYear) return "";
    if (!selectedEndYear) return selectedYear.toString();
    return `${selectedYear} a ${selectedEndYear}`;
  };

  return (
    <>
      {/* Seletor de ano */}
      <div className="mx-auto container my-8">
        <h2 className="text-3xl font-bold text-center mb-4">
          Vias Inseguras por Período
        </h2>
        
        {availableYears.length > 0 && (
          <YearSelector
            years={availableYears}
            selectedYear={selectedYear}
            selectedEndYear={selectedEndYear}
            onChange={handleYearChange}
          />
        )}
      </div>

      {/* Mapa com as vias mais perigosas */}
      <div className="mx-auto container my-8">
        <h2 className="text-3xl font-bold text-center mb-4">
          Mapa de Vias Inseguras
        </h2>
        <h3 className="text-xl text-center mb-8">
          {getPeriodoText()}
        </h3>
        
        <Map 
          layerData={mapData}
          layersConf={mapLayers}
          height="600px"
        />
      </div>

      {/* Tabela de vias inseguras */}
      <div className="mx-auto container my-8">
        <Table
          title={`Sinistros por Via - ${getPeriodoText()}`}
          data={filteredStreets}
          columns={[
            { Header: "(ID) Rua", accessor: "streetId", Filter: false },
            { Header: "Nome da Via", accessor: "name", Filter: ColumnFilter },
            {
              Header: "Total Sinistros",
              accessor: "totalSinistros",
              Filter: false,
            },
            { Header: "Fatais", accessor: "totalFatais", Filter: false },
          ]}
        />
      </div>

      {/* Arquivos de suporte */}
      {supportFiles && supportFiles.length > 0 && (
        <div className="mx-auto container my-12">
          <h2 className="text-3xl font-bold text-center mb-8">
            Documentos e Arquivos de Suporte
          </h2>
          <DocumentsList documents={supportFiles} docTypes={[]} />
        </div>
      )}
    </>
  );
}
